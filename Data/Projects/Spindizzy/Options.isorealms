{
  "project": {
    "description": "Options Menus",
    "modules": {
      "Basics": {
        "AnalogueControl": {
          "GERALD Movement X": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "deadZone": 0.15259000658988954
              },
              {
                "key": "Basics/DigitalToAnalogue",
                "name": "Left",
                "toValue": -1.0,
                "mappings": [
                  {
                    "key": "KeyboardKey",
                    "which": "ArrowLeft"
                  },
                  {
                    "key": "KeyboardKey",
                    "which": "A"
                  },
                  {
                    "key": "GameControllerHat",
                    "direction": "Left"
                  }
                ]
              },
              {
                "key": "Basics/DigitalToAnalogue",
                "name": "Right",
                "toValue": 1.0,
                "mappings": [
