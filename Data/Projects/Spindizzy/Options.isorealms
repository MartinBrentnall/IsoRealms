                  "variable": "basics"
                }
              ],
              "code": "currentDigitalInput:clearCustomInputs()\nfor i = 0, currentInputList:getMappingCount() - 1 do\n  currentDigitalInput:addCustomInput(currentInputList:getMapping(i))\nend\nbasics:persistGlobalConfiguration()\noptionsLoader:execute()\nscreenPopper:execute()"
            },
