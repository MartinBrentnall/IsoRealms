        "Font": {
          "Application Main Font": {
            "filename": {
              "path": "Fonts/Bubblegum_Sans/BubblegumSans-Regular.ttf"
            },
            "scale": 0.699999988079071,
            "offsetY": 0.20000000298023225
          }
        },
        "Function": {
          "Options Configure Input": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "screen"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Options Screen"
                },
                "variable": "input"
              },
              {
                "to": {
                  "key": "UI/Menu/Options Configure Input"
                },
                "variable": "menu"
              },
              {
                "to": {
                  "key": ":Screen",
                  "resource": {
                    "key": "UI/Menu/Options Configure Input"
                  }
                },
                "variable": "menuScreen"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "UI/Menu/Options Configure Input"
                  }
                },
                "variable": "menuInput"
              },
              {
                "to": {
                  "key": "Basics/String/Name of Input Being Configured"
                },
                "variable": "inputName"
              },
              {
                "to": {
                  "key": "UI/Menu/Options Configure Input/DigitalInput/Spindizzy"
                },
                "variable": "inputList"
              }
            ],
            "arguments": [
              {
                "name": "name",
                "type": {
                  "key": "Any"
                },
                "luaName": "name"
              },
              {
                "name": "digitalInput",
                "type": {
                  "key": "Any"
                },
                "luaName": "digitalInput"
              }
            ],
            "code": "table.insert(gMenuScreenStack, menuScreen)\ntable.insert(gMenuInputStack, menuInput)\nmenu:reset()\ninput:setInputHandler(menuInput)\nscreen:setScreen(menuScreen)\ninputName:setValue(name:getValue())\ncurrentInputList = inputList\ncurrentDigitalInput = digitalInput\ninputList:clear()\nfor i = 0, digitalInput:getMappingCount() - 1 do\n  inputList:addMapping(digitalInput:getMapping(i))\nend"
          },
          "Options Enter Screen": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "screen"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Options Screen"
                },
                "variable": "input"
              }
            ],
            "arguments": [
              {
                "name": "menuScreen",
                "type": {
                  "key": "Any"
                },
                "luaName": "menuScreen"
              },
              {
                "name": "menu",
                "type": {
                  "key": "Any"
                },
                "luaName": "menu"
              },
              {
                "name": "menuInput",
                "type": {
                  "key": "Any"
                },
                "luaName": "menuInput"
              }
            ],
            "code": "table.insert(gMenuScreenStack, menuScreen)\ntable.insert(gMenuInputStack, menuInput)\nmenu:reset()\ninput:setInputHandler(menuInput)\nscreen:setScreen(menuScreen)"
          },
          "Options Leave Screen": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "screen"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Options Screen"
                },
                "variable": "input"
              },
              {
                "to": {
                  "key": "Basics/String/Name of Input Being Configured"
                },
                "variable": "inputName"
              }
            ],
            "code": "table.remove(gMenuScreenStack)\ntable.remove(gMenuInputStack)\ninput:setInputHandler(gMenuInputStack[#gMenuInputStack])\nscreen:setScreen(gMenuScreenStack[#gMenuScreenStack])\ninputName:setValue(\"\")"
          },
          "Options Reload Configuration": {
            "bindings": [
