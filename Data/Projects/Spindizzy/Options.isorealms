                },
                "variable": "inputBrake"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Camera Rotate Left"
                },
                "variable": "inputRotateViewLeft"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Camera Rotate Right"
                },
                "variable": "inputRotateViewRight"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Camera Reverse"
                },
                "variable": "inputReverseView"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Camera Reset"
                },
                "variable": "inputResetView"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Toggle Map"
                },
                "variable": "inputToggleMap"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/GERALD Transform"
                },
                "variable": "inputToggleCraft"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/Toggle Pause"
                },
                "variable": "inputTogglePause"
              },
              {
                "to": {
                  "key": "Basics/DigitalControl/GERALD Destruct"
                },
                "variable": "inputDestruct"
              }
            ],
            "code": "fullScreen = application:isFullScreen()\nsoundVolume = basics:getSoundVolume()\n-- musicVolume = basics:getMusicVolume()\noptionFullScreen:setValue(fullScreen)\nsoundVolumeSlider:setValue(soundVolume)\n-- musicVolumeSlider:setValue(musicVolume)\n\noptionLeft:setValue(inputLeft:getInputsString())\noptionRight:setValue(inputRight:getInputsString())\noptionUp:setValue(inputUp:getInputsString())\noptionDown:setValue(inputDown:getInputsString())\noptionThrust:setValue(inputThrust:getInputsString())\noptionBrake:setValue(inputBrake:getInputsString())\noptionRotateViewLeft:setValue(inputRotateViewLeft:getInputsString())\noptionRotateViewRight:setValue(inputRotateViewRight:getInputsString())\noptionReverseView:setValue(inputReverseView:getInputsString())\noptionResetView:setValue(inputResetView:getInputsString())\noptionToggleMap:setValue(inputToggleMap:getInputsString())\noptionToggleCraft:setValue(inputToggleCraft:getInputsString())\noptionTogglePause:setValue(inputTogglePause:getInputsString())\noptionDestruct:setValue(inputDestruct:getInputsString())"
          },
