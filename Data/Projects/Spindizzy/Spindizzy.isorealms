        "BoundaryHandler": {
          "GERALD Collects Jewels": {
            "object": {
              "key": "Player/Player"
            },
            "boundary": {
              "key": "PickUp/Jewel"
            },
            "onEntry": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/Jewel Collected"
                    }
                  },
                  "variable": "sound"
                },
                {
                  "to": {
                    "key": "Basics/Integer/Score"
                  },
                  "variable": "score"
                },
                {
                  "to": {
                    "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                  },
                  "variable": "gameTimeLimit"
                },
                {
                  "to": {
                    "key": "Basics/Integer/Collected Jewel Count"
                  },
                  "variable": "jewelsCollected"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Boundary/Zone"
                  },
                  "variable": "zone"
                },
                {
                  "to": {
                    "key": ":Integer",
                    "resource": {
                      "key": "Basics/Integer/Remaining Zones Count"
                    }
                  },
                  "variable": "zoneCount"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World"
                  },
                  "variable": "hangworld"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Equilibria Play Ending Cutscene",
                      "bindings": []
                    }
                  },
                  "variable": "ending"
                }
              ],
              "code": "sound:execute()\njewelsCollected:setValue(jewelsCollected:getValue() + 1)\nlocal earned = 600\nlocal newTime = gameTimeLimit:getTime() - 12000\nif newTime < 0 then\n  local excess = -newTime\n  local extraScore = excess / 10\n  earned = earned + extraScore\n  newTime = 0\nend\ngameTimeLimit:setTime(newTime)\n\nscore:setValue(math.floor(score:getValue() + earned))\n\n-- Do we show the ending yet?\nif zoneCount:getValue() == 0 and hangworld:getPickUpCount() == jewelsCollected:getValue() then\n  ending:execute()\nend"
            },
            "onExit": {
              "key": "None"
            }
          },
          "GERALD Explores Zones": {
            "object": {
              "key": "Player/Player"
            },
            "boundary": {
              "key": "Zone/Zone"
            },
            "onEntry": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Boundary/Zone"
                  },
                  "variable": "zone"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Boundary/Zone/WorldView/World Map/ZoneView"
                  },
                  "variable": "zoneColour"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Equilibria Handle Zone Entered",
                      "bindings": []
                    }
                  },
                  "variable": "zoneEnterFunction"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Options Reload Configuration",
                      "bindings": []
                    }
                  },
                  "variable": "optionsLoader"
                }
              ],
              "code": "-- Hack to reload the controls when starting the game.\nif firstZoneEntered == 0 then\n  optionsLoader:execute()\n  firstZoneEntered = 1\nend\nentered = zone\nenteredColour = zoneColour\nzoneEnterFunction:execute()"
            },
            "onExit": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Boundary/Zone"
                  },
                  "variable": "zone"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Boundary/Zone/WorldView/World Map/ZoneView"
                  },
                  "variable": "zoneColour"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Equilibria Handle Zone Exited",
                      "bindings": []
                    }
                  },
                  "variable": "zoneExitFunction"
                }
              ],
              "code": "exited = zone\nexitedColour = zoneColour\nzoneExitFunction:execute()"
            }
          }
        },
        "CollisionHandler": {
          "GERALD Takes Damage from Alien Type 1": {
            "objectA": {
              "key": "Player/Player"
            },
            "objectB": {
              "key": "Alien/Enemy Type 1"
            },
            "onCollision": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                  },
                  "variable": "sound"
                },
                {
                  "to": {
                    "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                  },
                  "variable": "damage"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Alien Damage Indicator"
                  },
                  "variable": "screen"
                },
                {
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Layout/Equilibria Damage Indicator"
                    }
                  },
                  "variable": "indicator"
                },
                {
                  "to": {
                    "key": "Basics/Float/Game Time Limit Countdown Speed"
                  },
                  "variable": "timeSpeed"
                }
              ],
              "code": "if alienContactCount == 0 then\n  sound:play()\n  damage:play()\n  screen:setScreen(indicator)\nend\nalienContactCount = alienContactCount + 1\ntimeSpeed:setValue(1.0 + alienContactCount * 20.0)"
            },
            "onParting": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                  },
                  "variable": "sound"
                },
                {
                  "to": {
                    "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                  },
                  "variable": "damage"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Alien Damage Indicator"
                  },
                  "variable": "screen"
                },
                {
                  "to": {
                    "key": "Basics/Float/Game Time Limit Countdown Speed"
                  },
                  "variable": "timeSpeed"
                }
              ],
              "code": "alienContactCount = alienContactCount - 1\nif alienContactCount == 0 then\n  sound:pause()\n  damage:pause()\n  screen:setScreen(nil)\nend\ntimeSpeed:setValue(1.0 + alienContactCount * 20.0)"
            }
          },
