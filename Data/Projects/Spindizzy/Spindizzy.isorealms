                      "key": "Equilibria"
                    },
                    "variable": "equilibria"
                  },
                  {
                    "to": {
                      "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                    },
                    "variable": "sound"
                  },
                  {
                    "to": {
                      "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                    },
                    "variable": "damage"
                  }
                ],
                "code": "locks = locks + 1\nif locks == 1 then\n  equilibria:setPause(true)\n  gameTimeLimit:pause()\n  if alienContactCount > 0 then\n    sound:pause()\n    damage:pause()\n  end\nend"
              },
              "onEndArrival": {
                "key": "None"
              },
              "onEndDeparture": {
                "key": "None"
              },
              "onStartArrival": {
                "key": "Basics/Script",
                "bindings": [
                  {
                    "to": {
                      "key": "Equilibria/World/Game World"
                    },
                    "variable": "map"
                  },
                  {
                    "to": {
                      "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                    },
                    "variable": "gameTimeLimit"
                  },
                  {
                    "to": {
                      "key": "Equilibria"
                    },
                    "variable": "equilibria"
                  },
                  {
                    "to": {
                      "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                    },
                    "variable": "sound"
                  },
                  {
                    "to": {
                      "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                    },
                    "variable": "damage"
                  }
                ],
                "code": "locks = locks - 1\nif locks == 0 then\n  equilibria:setPause(false)\n  if GlobalExplorer ~= 1 then\n    gameTimeLimit:play()\n  end\n  if alienContactCount > 0 then\n    sound:play()\n    damage:play()\n  end\nend"
              }
            },
