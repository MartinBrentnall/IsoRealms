        "Float": {
          "Game Time Limit Countdown Speed": {
            "value": 1.0
          }
        },
        "Function": {
          "Application Quit": {
            "bindings": [
              {
                "to": {
                  "key": "Project"
                },
                "variable": "project"
              }
            ],
            "code": "project:finish(false)"
          },
          "Equilibria Activate State": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStatePrimary"
                },
                "variable": "switchIconPrimary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStateSecondary"
                },
                "variable": "switchIconSecondary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/Hint"
                },
                "variable": "hintIcon"
              }
            ],
            "arguments": [
              {
                "name": "State",
                "type": {
                  "key": "Equilibria/Terrain State"
                },
                "luaName": "switchState"
              },
              {
                "name": "Icon",
                "type": {
                  "key": "Screen"
                },
                "luaName": "switchIcon"
              },
              {
                "name": "Sound",
                "type": {
                  "key": "Action"
                },
                "luaName": "sound"
              }
            ],
            "code": "if activeSwitchA ~= switchState or activeSwitchB ~= nil then\nsound:execute()\nnextSwitch = 1\nif activeSwitchA ~= nil then\n  activeSwitchA:setValue(false)\nend\nif activeSwitchB ~= nil then\n  activeSwitchB:setValue(false)\n  switchIconSecondary:setScreen(nil)\n  activeSwitchB = nil\nend\nswitchState:setValue(true)\nif disableHud == nil then\n  switchIconPrimary:setScreen(switchIcon)\nend\nactiveSwitchA = switchState;\n\n-- Update the hint icon\nif currentZone ~= nil and disableHud == nil then\n  local hintCount = currentZone:getHintCount()\n  if hintCount > 0 then\n    currentZone:giveHint(0)\n  else\n    hintIcon:setScreen(nil)\n  end\nend\nend"
          },
          "Equilibria Activate State (retain last state)": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStatePrimary"
                },
                "variable": "switchIconPrimary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStateSecondary"
                },
                "variable": "switchIconSecondary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/Hint"
                },
                "variable": "hintIcon"
              }
            ],
            "arguments": [
              {
                "name": "switchState",
                "type": {
                  "key": "Equilibria/Terrain State"
                },
                "luaName": "switchState"
              },
              {
                "name": "switchIcon",
                "type": {
                  "key": "Screen"
                },
                "luaName": "switchIcon"
              },
              {
                "name": "sound",
                "type": {
                  "key": "Action"
                },
                "luaName": "sound"
              }
            ],
            "code": "if activeSwitchA ~= switchState and activeSwitchB ~= switchState then\nsound:execute()\nif nextSwitch == 1 then\n  if activeSwitchB ~= nil then\n    activeSwitchB:setValue(false)\n  end\n  activeSwitchB = switchState\n  if disableHud == nil then\n    switchIconSecondary:setScreen(switchIcon)\n  end\n  nextSwitch = 0\nelse\n  if activeSwitchA ~= nil then\n    activeSwitchA:setValue(false)\n  end\n  activeSwitchA = switchState\n  if disableHud == nil then\n    switchIconPrimary:setScreen(switchIcon)\n  end\n  nextSwitch = 1\nend\nswitchState:setValue(true)\n\n-- Update the hint icon\nif currentZone ~= nil and disableHud == nil then\n  local hintCount = currentZone:getHintCount()\n  if hintCount > 0 then\n    currentZone:giveHint(0)\n  else\n    hintIcon:setScreen(nil)\n  end\nend\nend"
          },
          "Equilibria Deactivate All States": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStatePrimary"
                },
                "variable": "switchIconPrimary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/SwitchStateSecondary"
                },
                "variable": "switchIconSecondary"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/Hint"
                },
                "variable": "hintIcon"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Sound/Deactivate All States"
                  }
                },
                "variable": "sound"
              }
            ],
            "code": "if activeSwitchA ~= nil then\n  sound:execute()\n  nextSwitch = 0\n  activeSwitchA:setValue(false)\n  switchIconPrimary:setScreen(nil)\n  activeSwitchA = nil\n  if activeSwitchB ~= nil then\n    activeSwitchB:setValue(false)\n    switchIconSecondary:setScreen(nil)\n    activeSwitchB = nil\n  end\n\n  -- Update the hint icon\n  if currentZone ~= nil and disableHud == nil then\n    local hintCount = currentZone:getHintCount()\n    if hintCount > 0 then\n      currentZone:giveHint(0)\n    else\n      hintIcon:setScreen(nil)\n    end\n  end\nend"
          },
          "Equilibria Game Pause": {
            "bindings": [
              {
                "to": {
                  "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                },
                "variable": "gameTimeLimit"
              },
              {
                "to": {
                  "key": "Equilibria"
                },
                "variable": "equilibria"
              },
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "screenSwitch"
              },
              {
                "to": {
                  "key": ":Screen",
                  "resource": {
                    "key": "UI/Menu/Pause"
                  }
                },
                "variable": "screenMenu"
              },
              {
                "to": {
                  "key": "UI/Menu/Pause"
                },
                "variable": "menu"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Options Screen"
                },
                "variable": "inputSwitchFE"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "UI/Menu/Pause"
                  }
                },
                "variable": "inputHandlerMenu"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                },
                "variable": "sound"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                },
                "variable": "damage"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "mainInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputSwitch/Options Screen"
                  }
                },
                "variable": "optionsInput"
              }
            ],
            "code": "if hasFocus then\n\n  -- Pause the game\n  locks = locks + 1\n  if locks == 1 then\n    equilibria:setPause(true)\n    gameTimeLimit:pause()\n    if alienContactCount > 0 then\n      sound:pause()\n      damage:pause()\n    end\n  end\n  hasFocus = false\n\n  -- Show the menu\n  table.insert(gMenuScreenStack, screenMenu)\n  table.insert(gMenuInputStack, inputHandlerMenu)\n  screenSwitch:setScreen(screenMenu)\n  menu:reset()\n  inputSwitchFE:setInputHandler(inputHandlerMenu)\n  mainInput:setInputHandler(optionsInput)\nend"
          },
          "Equilibria Game Unpause": {
            "bindings": [
              {
                "to": {
                  "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                },
                "variable": "gameTimeLimit"
              },
              {
                "to": {
                  "key": "Equilibria"
                },
                "variable": "equilibria"
              },
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "screen"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Options Screen"
                },
                "variable": "menuInput"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "mainInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputGroup/Equilibria Game Controls"
                  }
                },
                "variable": "gameControls"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                },
                "variable": "sound"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                },
                "variable": "damage"
              }
            ],
            "code": "-- Unpause the game\nlocks = locks - 1\nif locks == 0 then\n  equilibria:setPause(false)\n  if GlobalExplorer ~= 1 then\n    gameTimeLimit:play()\n  end\n  if alienContactCount > 0 then\n    sound:play()\n    damage:play()\n  end\nend\nhasFocus = true\n\n-- Remove the menu\nwhile #gMenuScreenStack > 0 do\n  table.remove(gMenuScreenStack)\n  table.remove(gMenuInputStack)\nend\nscreen:setScreen(nil)\nmenuInput:setInputHandler(nil)\nmainInput:setInputHandler(gameControls)"
          },
          "Equilibria Handle Zone Entered": {
            "bindings": [
              {
                "to": {
                  "key": "Basics/Integer/Score"
                },
                "variable": "score"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                },
                "variable": "gameTimeLimit"
              },
              {
                "to": {
                  "key": "Basics/Integer/Remaining Zones Count"
                },
                "variable": "zoneCount"
              },
              {
                "to": {
                  "key": "UI/Layout/Equilibria HUD/Hint"
                },
                "variable": "hintIcon"
              },
              {
                "to": {
                  "key": "Equilibria/ThemeSet/C64"
                },
                "variable": "themeSet"
              },
              {
                "to": {
                  "key": "Equilibria/World/Game World/DebrisGenerator/Top"
                },
                "variable": "topDebris"
              },
              {
                "to": {
                  "key": "Equilibria/World/Game World/DebrisGenerator/Ball"
                },
                "variable": "ballDebris"
              },
              {
                "to": {
                  "key": "Equilibria/World/Game World/DebrisGenerator/Gyroscope"
                },
                "variable": "gyroscopeDebris"
              },
              {
                "to": {
                  "key": "Equilibria/WorldView/Game View"
                },
                "variable": "view"
              },
              {
                "to": {
                  "key": ":Integer",
                  "resource": {
                    "key": "Basics/Integer/Collected Jewel Count"
                  }
                },
                "variable": "jewelsCollected"
              },
              {
                "to": {
                  "key": "Equilibria/World/Game World"
                },
                "variable": "hangworld"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/Equilibria Play Ending Cutscene",
                    "bindings": []
                  }
                },
                "variable": "ending"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Timer (Minimum Zone Visible Time)/Instance"
                },
                "variable": "mandatoryZoneTime"
              },
              {
                "to": {
                  "key": "Equilibria"
                },
                "variable": "equilibria"
              },
              {
                "to": {
                  "key": ":Colour",
                  "resource": {
                    "key": "Basics/Sequence/Colour Cycle (Overview Current Zone)/Instance/Colour"
                  }
                },
                "variable": "currentZoneColour"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                },
                "variable": "sound"
              },
              {
                "to": {
                  "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                },
                "variable": "damage"
              }
            ],
            "code": "-- Delay entry to the previous zone when leaving too quickly.\nif mandatoryZoneTime:getTime() > 200 or entered ~= previousZone then\n\n  -- Clear all debris from the screen.\n  if entered ~= exitedZone then\n    topDebris:clear()\n    ballDebris:clear()\n    gyroscopeDebris:clear()\n  end\n\n  -- Keep track of the current zone and the previous zone.\n  previousZone = currentZone\n  currentZone = entered\n\n  -- Update timer, score, and overview if this is the first time visiting the zone.\n  -- TODO: Can test colour from zone to determine if visited.\n  if entered:isVisited() == false then\n    zoneCount:setValue(zoneCount:getValue() - 1)\n    local earned = 400\n    local newTime = gameTimeLimit:getTime() - 8000\n    -- Any time to add beyond the 3-minute cap is converted to additional score bonus.\n    if newTime < 0 then\n      local excess = -newTime\n      local extraScore = excess / 10\n      earned = earned + extraScore\n      newTime = 0\n    end\n    gameTimeLimit:setTime(newTime)\n    score:setValue(math.floor(score:getValue() + earned))\n\n    -- Set that the zone has been visited.\n    entered:setVisited()\n  end\n\n  -- Set the colour on the overview to show where we are.\n  enteredColour:setColour(currentZoneColour)\n\n  -- Set the zone to show in our view.\n  view:setZone(entered)\n\n  -- Set the default theme to use in the UI.\n  theme = entered:getTheme()\n  themeSet:setDefaultTheme(theme)\n\n  -- Activate dynamic objects in the zone.\n  entered:resetDynamics()\n  entered:setActive(true)\n\n  -- Update the hint icon\n  if disableHud == nil then\n    local hintCount = currentZone:getHintCount()\n    if hintCount > 0 then\n      currentZone:giveHint(0)\n    else\n      hintIcon:setScreen(nil)\n    end\n  end\n\n  -- Do we show the ending yet?\n  if zoneCount:getValue() == 0 and hangworld:getPickUpCount() == jewelsCollected:getValue() then\n    ending:execute()\n  end\n  mandatoryZoneTime:setTime(0);\nelse\n  -- The entrance delay is implemented by momentarily pausing the game.\n  zoneToEnter = entered\n  equilibria:setPause(true)\n  gameTimeLimit:pause()\n  if alienContactCount > 0 then\n    sound:pause()\n    damage:pause()\n  end\nend"
          },
          "Equilibria Handle Zone Exited": {
            "bindings": [
              {
                "to": {
                  "key": ":Colour",
                  "resource": {
                    "key": "Basics/Colour/C64 Palette 8"
                  }
                },
                "variable": "doneColour"
              },
              {
                "to": {
                  "key": ":Colour",
                  "resource": {
                    "key": "Basics/Colour/C64 Palette 5"
                  }
                },
                "variable": "missedColour"
              }
            ],
            "code": "exitedZone = exited\nif exited ~= nil then\n  exited:setActive(false)\n  exited:resetLifts()\n\n  if exited:getRemainingPickUpCount() > 0 then\n    exitedColour:setColour(missedColour)\n  else\n    exitedColour:setColour(doneColour)\n  end\n  exitedColour = nil\nend"
          },
