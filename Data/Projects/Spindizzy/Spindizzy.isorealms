                        "code": "-- Stooop alien damage; we've probably had enough of that...\nsound:pause()\ndamage:pause()\nscreen:setScreen(nil)\n\n-- Pause the game\nlocks = locks + 1\nif locks == 1 then\n  equilibria:setPause(true)\n  gameTimeLimit:pause()\nend\n\nlocal message = endMessage:getValue()\nif string.len(message) == 0 then\n  endMessage:setValue(\"Fuel Depleted: Mission Aborted\")\nend\n\n-- Calculate some rounded percentages\ntotalZones = hangworld:getZoneCount()\nmappedPercentage = math.ceil((math.abs((zoneCount:getValue() / totalZones) - 1) * 100) - 0.5)\ntotalJewels = hangworld:getPickUpCount()\njewelsPercentage = math.ceil(((jewelsCollected:getValue() / totalJewels) * 100) - 0.5)\ncompletePercentage = math.ceil(((mappedPercentage + jewelsPercentage) / 2) - 0.5)\n\n-- Set result values\nmappedMessage:setValue(\"\" .. mappedPercentage .. \"%\")\njewelsMessage:setValue(\"\" .. jewelsPercentage .. \"%\")\ncompleteMessage:setValue(\"\" .. completePercentage .. \"%\")\nif GlobalExplorer ~= 1 then\n  scoreMessage:setValue(\"\" .. score:getValue())\nelse\n  -- Prevent high score from triggering\n  score:setValue(-1)\n  scoreMessage:setValue(\"N/A\")\n  GlobalExplorer = nil\nend\nhasFocus = false\ngameOverSequence:play()"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "Timer (Minimum Zone Visible Time)": {
            "playing": true,
            "speed": {
              "key": "Literal",
              "value": 1.0
            },
            "instances": [
              {
                "name": "Instance"
              }
            ],
            "tracks": [
              {
                "track": {
                  "key": "Action",
                  "events": [
                    {
                      "delay": 1000,
                      "execute": {
                        "key": "Basics/Script",
                        "bindings": [
                          {
                            "to": {
                              "key": "Equilibria"
                            },
                            "variable": "equilibria"
                          },
                          {
                            "to": {
                              "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                            },
                            "variable": "gameTimeLimit"
                          },
                          {
                            "to": {
                              "key": ":Action",
                              "resource": {
                                "key": "Basics/Function/Equilibria Handle Zone Entered",
                                "bindings": []
                              }
                            },
                            "variable": "zoneEnterFunction"
                          },
                          {
                            "to": {
                              "key": "Basics/Sequence/Alien Damage (Sound Loop)/Instance"
                            },
                            "variable": "sound"
                          },
                          {
                            "to": {
                              "key": "Basics/Sequence/Alien Damage (Screen Border Effect)/Instance"
                            },
                            "variable": "damage"
                          }
                        ],
                        "code": "if zoneToEnter ~= nil then\n  equilibria:setPause(false)\n  if GlobalExplorer ~= 1 then\n    gameTimeLimit:play()\n  end\n  if alienContactCount > 0 then\n    sound:play()\n    damage:play()\n  end\n  entered = zoneToEnter\n  zoneEnterFunction:execute()\n  zoneToEnter = nil\nend"
                      }
                    }
                  ]
                }
              }
            ]
          }
