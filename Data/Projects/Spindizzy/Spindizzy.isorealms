        "Player": {
          "Player": {
            "bounceFactor": 0.3100000023841858,
            "appearance": {
              "key": "Equilibria/ModelCycler/Player Craft/0"
            },
            "spinSpeed": -180.0,
            "xInput": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Movement X"
            },
            "yInput": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Movement Y"
            },
            "thrustInput": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Thrust"
            },
            "onRespawn": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                  },
                  "variable": "gameTimeLimit"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/GERALD Respawn"
                    }
                  },
                  "variable": "soundRespawnHard"
                }
              ],
              "code": "local newTime = gameTimeLimit:getTime() + 10000\ngameTimeLimit:setTime(newTime)\nif gPlayerLeftSurfaceMomentumZ > 0.0 then\n  soundRespawnHard:execute()\nend"
            },
            "onFallImpact": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Top"
                  },
                  "variable": "topDebris"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Ball"
                  },
                  "variable": "ballDebris"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Gyroscope"
                  },
                  "variable": "gyroscopeDebris"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Player"
                  },
                  "variable": "player"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/GERALD Surface Impact Hard"
                    }
                  },
                  "variable": "soundImpactHard"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/GERALD Surface Impact Medium"
                    }
                  },
                  "variable": "soundImpactMedium"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/GERALD Surface Impact Soft"
                    }
                  },
                  "variable": "soundImpactSoft"
                }
              ],
              "code": "player:setStepReach(0.5)\nlocation = player:getLocation()\nif (gPlayerLeftSurfaceAtZ - location:getZ() > 2.75) then\n  momentum = player:getMomentum()\n  xMomentum = momentum:getX()\n  yMomentum = momentum:getY()\n  zMomentum = momentum:getZ()\n  player:destroy()\n  soundImpactHard:execute()\n  if spinType == 0 then\n    for i = 1, 5 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = zMomentum * math.random()\n      topDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  elseif spinType == 1 then\n    for i = 1, 8 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = zMomentum * math.random()\n      ballDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  elseif spinType == 2 then\n    for i = 1, 12 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = zMomentum * math.random()\n      gyroscopeDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  end\nelse\n  hitX = location:getX()\n  hitY = location:getY()\n  distX = math.abs(gPlayerLeftSurfaceAtX - hitX)\n  distY = math.abs(gPlayerLeftSurfaceAtY - hitY)\n  dist = math.max(distX, distY)\n  if gPlayerLeftSurfaceMomentumZ > 0.0 then\n    if dist > 1.98 then\n      soundImpactHard:execute()\n    elseif dist > 1.0 then\n      soundImpactMedium:execute()\n    elseif dist > 0.5 then\n      soundImpactSoft:execute()\n    end\n  end\nend"
            },
            "onFallBounce": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Player"
                  },
                  "variable": "player"
                }
              ],
              "code": "-- This is kinda hacky for a difficult part of the game.\nif (gPlayerLeftSurfaceAtZ - location:getZ() > 2.75) then\n  player:setStepReach(0.93)\nelse\n  player:setStepReach(0.8)\nend\n\n-- Bounce height increases under certain conditions.\nif fallDistance:getValue() > 2.75 or gPlayerLeftSurfaceMomentumZ ~= 0.0 then\n  player:setBounceFactor(0.31)\nelse\n  player:setBounceFactor(0.0)\nend"
            },
            "onWallBounce": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Player/Player"
                  },
                  "variable": "player"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Terrain/Zone"
                  },
                  "variable": "wallZone"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Terrain/Zone/WorldView/World Map/ZoneView"
                  },
                  "variable": "wallZoneColour"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Player/Zone/WorldView/World Map/ZoneView"
                  },
                  "variable": "playerZoneColour"
                },
                {
                  "to": {
                    "key": "~",
                    "local": "Terrain/Wall"
                  },
                  "variable": "wall"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Equilibria Handle Zone Entered",
                      "bindings": []
                    }
                  },
                  "variable": "zoneEnterFunction"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/Equilibria Handle Zone Exited",
                      "bindings": []
                    }
                  },
                  "variable": "zoneExitFunction"
                }
              ],
              "code": "-- This action is only applicable when the wall is in a different zone than the player.\nif player:getZone() ~= wallZone and player:getZone() ~= nil and wall:isAtZoneEdge() then\n\n  -- Leave the current zone and enter the zone where the wall is.\n  zoneToExit = player:getZone();\n  zoneToEnter = wallZone;\n  if zoneToExit ~= nil then\n    exited = zoneToExit\n    exitedColour = playerZoneColour\n    zoneExitFunction:execute()\n    exited = nil\n  end\n  if zoneToEnter ~= nil then\n    entered = zoneToEnter\n    enteredColour = wallZoneColour\n    zoneEnterFunction:execute()\n    entered = nil\n  end\n\n  -- Leave the zone where the wall is and return to the player's zone.\n  -- The pause mechanism will trigger automatically since no time has passed.\n  zoneToEnter = player:getZone()\n  zoneToExit = wallZone;\n  if zoneToExit ~= nil then\n    exited = zoneToExit\n    exitedColour = wallZoneColour\n    zoneExitFunction:execute()\n    exited = nil\n  end\n  if zoneToEnter ~= nil then\n    entered = zoneToEnter\n    enteredColour = playerZoneColour\n    zoneEnterFunction:execute()\n    entered = nil\n  end\nend"
            },
            "onLeaveSurface": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Player"
                  },
                  "variable": "player"
                }
              ],
              "code": "-- Store position at which the surface was left.\nlocal mPlayerLocation = player:getLocation()\ngPlayerLeftSurfaceAtX = mPlayerLocation:getX()\ngPlayerLeftSurfaceAtY = mPlayerLocation:getY()\ngPlayerLeftSurfaceAtZ = mPlayerLocation:getZ()\n\n-- Store verticale momentum at which surface was left.\nlocal mPlayerMomentum = player:getMomentum()\ngPlayerLeftSurfaceMomentumZ = mPlayerMomentum:getZ()"
            },
            "onApex": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "~",
                    "local": "Player"
                  },
                  "variable": "player"
                }
              ],
              "code": "-- Store current position to calculate fall height.\nlocal mPlayerLocation = player:getLocation()\ngPlayerLeftSurfaceAtZ = mPlayerLocation:getZ()"
            },
            "orientation": {
              "key": "Equilibria/WorldView/Game View/Camera/Yaw"
            }
          }
        },
