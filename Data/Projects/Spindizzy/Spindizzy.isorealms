        "Prompt": {
          "Abort Mission": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
            },
            "message": "Abort Mission?",
            "cancelLabel": "No",
            "confirmLabel": "Yes",
            "onCancel": {
              "key": "Basics/Function/Options Leave Screen",
              "bindings": []
            },
            "onConfirm": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                  },
                  "variable": "gameTimeLimit"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Menu"
                  },
                  "variable": "screen"
                },
                {
                  "to": {
                    "key": "Equilibria"
                  },
                  "variable": "equilibria"
                },
                {
                  "to": {
                    "key": "Basics/String/Message End Cause"
                  },
                  "variable": "endingMessage"
                }
              ],
              "code": "-- Setting time to 3 minutes causes mission to end\ngameTimeLimit:setTime(180000)\n\n-- Pop all menu screens\nwhile #gMenuScreenStack > 0 do\n  table.remove(gMenuScreenStack)\n  table.remove(gMenuInputStack)\nend\n\n-- Set message that player has quit\nendingMessage:setValue(\"Cartographer Quit: Mission Aborted\")\n\n-- Get rid of the prompt\nscreen:setScreen(nil)\n\n-- Unpause the game\nlocks = locks - 1\nif locks == 0 then\n  equilibria:setPause(false)\n  if GlobalExplorer ~= 1 then\n    gameTimeLimit:play()\n  end\nend\n\n-- Disable menu access\nhasFocus = false"
            }
          }
        },
