{
  "project": {
    "description": "Game Mechanics and Assets",
    "include": [
      {
        "filename": {
          "path": "Projects/Spindizzy/Options.isorealms"
        }
      }
    ],
    "launchConfigurations": {
      "Record Demo": {
        "options": {
          "Replayer": {
            "key": "Literal",
            "value": "Recording"
          },
          "File": {
            "key": "Literal",
            "value": "Demo.recording"
          }
        }
      },
      "Replay Demo": {
        "options": {
          "Replayer": {
            "key": "Literal",
            "value": "Replaying"
          },
          "File": {
            "key": "Literal",
            "value": "Demo.recording"
          },
          "User": {
            "key": "Literal",
            "value": "true"
          }
        }
      },
      "Replay Demo (no HUD)": {
        "options": {
          "Replayer": {
            "key": "Literal",
            "value": "Replaying"
          },
          "File": {
            "key": "Literal",
            "value": "Demo.recording"
          },
          "User": {
            "key": "Literal",
            "value": "true"
          },
          "Show HUD": {
            "key": "Literal",
            "value": "false"
          }
        }
      }
    },
    "onStart": {
      "key": "Basics/Script",
      "bindings": [
        {
          "to": {
            "key": "Basics/Integer/Remaining Zones Count"
          },
          "variable": "zoneCount"
        },
        {
          "to": {
            "key": "Equilibria/World/Game World"
          },
          "variable": "hangworld"
        },
        {
          "to": {
            "key": "Equilibria/World/Game World/Player"
          },
          "variable": "player"
        },
        {
          "to": {
            "key": "UI/Layout/Equilibria HUD/SwitchStatePrimary"
          },
          "variable": "switchIconPrimary"
        },
        {
          "to": {
            "key": "UI/Layout/Equilibria HUD/SwitchStateSecondary"
          },
          "variable": "switchIconSecondary"
        },
        {
          "to": {
            "key": "Equilibria/WorldView/Game View"
          },
          "variable": "view"
        },
        {
          "to": {
            "key": "Equilibria"
          },
          "variable": "equilibria"
        },
        {
          "to": {
            "key": "Options"
          },
          "variable": "options"
        },
        {
          "to": {
            "key": "Replay/Replayer/Gameplay Recorder"
          },
          "variable": "replayer"
        },
        {
          "to": {
            "key": "UI/Layout/Main/Equilibria HUD"
          },
          "variable": "hudComponent"
        },
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/Options Reload Configuration",
              "bindings": []
            }
          },
          "variable": "optionsLoader"
        },
        {
          "to": {
            "key": "Application"
          },
          "variable": "application"
        }
      ],
      "code": "-- Start recording if specified\nlocal mReplayerMode = options:getOption(\"Replayer\")\nif mReplayerMode == \"Recording\" then\n  local mReplayerFile = options:getOption(\"File\")\n  replayer:setRecording(mReplayerFile)\nelseif mReplayerMode == \"Replaying\" then\n  local mReplayerFile = options:getOption(\"File\")\n  local mReplayerUser = options:getOption(\"User\")\n  replayer:setReplaying(mReplayerFile, mReplayerUser == \"true\")\nelse\n  replayer:setInactive()\nend\n\n-- Option to make the HUD invisible (for attract mode).\nlocal mHUD = options:getOption(\"Show HUD\")\nif mHUD == \"false\" then\n  hudComponent:setScreen(nil)\nend\n\n-- Refresh the control mappings.\noptionsLoader:execute()\n\n-- Reset Lua variables.\ngMenuScreenStack = {}\ngMenuInputStack = {}\nmapOverviewMode = 0\nspinType = 0\nhasFocus = true\nlocks = 0\nalienContactCount = 0\nfirstZoneEntered = 0\nnextSwitch = 0\nactiveSwitchA = nil\nactiveSwitchB = nil\n\n-- Unpause the game.\nequilibria:setPause(false)\n\n-- Reset zone count.\nzoneCount:setValue(hangworld:getZoneCount())\n\n-- Set the title bar of the Window.\napplication:setName(\"IsoRealms Spindizzy\")"
    },
    "onCloseRequest": {
      "key": "Quit"
    },
    "input": {
      "key": "Basics/InputSwitch/Main"
    },
    "screen": {
      "key": "UI/Layout/Main"
    },
    "editor": {
      "key": "Equilibria/World/Game World"
    },
    "modules": {
      "Basics": {
        "BooleanTrigger": {
          "Camera Reset": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Camera Reset"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/WorldView/Game View/Camera/Start"
                  },
                  "variable": "viewAngle"
                }
              ],
              "code": "viewAngle:faceNorthWest();"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Camera Reverse": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Camera Reverse"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/WorldView/Game View/Camera/Start"
                  },
                  "variable": "viewAngle"
                }
              ],
              "code": "viewAngle:flip();"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Camera Rotate Left": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Camera Rotate Left"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/WorldView/Game View/Camera/Start"
                  },
                  "variable": "viewAngle"
                }
              ],
              "code": "viewAngle:rotateLeft();"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Camera Rotate Right": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Camera Rotate Right"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/WorldView/Game View/Camera/Start"
                  },
                  "variable": "viewAngle"
                }
              ],
              "code": "viewAngle:rotateRight();"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "GERALD Brake": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Brake"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/World/Game World/Player"
                  },
                  "variable": "player"
                },
                {
                  "to": {
                    "key": "Basics/Sequence/Timer (Game Time Limit)/Instance"
                  },
                  "variable": "gameTimeLimit"
                }
              ],
              "code": "if hasFocus then\n  player:stop()\n  if GlobalExplorer ~= 1 then\n    local newTime = gameTimeLimit:getTime() + 500\n    gameTimeLimit:setTime(newTime)\n  end\nend"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "GERALD Destruct": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Destruct"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/World/Game World/Player"
                  },
                  "variable": "player"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Sound/GERALD Surface Impact Hard"
                    }
                  },
                  "variable": "soundImpactHard"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Top"
                  },
                  "variable": "topDebris"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Ball"
                  },
                  "variable": "ballDebris"
                },
                {
                  "to": {
                    "key": "Equilibria/World/Game World/DebrisGenerator/Gyroscope"
                  },
                  "variable": "gyroscopeDebris"
                }
              ],
              "code": "if hasFocus and player:isAlive() then\n  location = player:getLocation()\n  momentum = player:getMomentum()\n  xMomentum = momentum:getX()\n  yMomentum = momentum:getY()\n  zMomentum = momentum:getZ()\n  player:destroy()\n  soundImpactHard:execute()\n  if spinType == 0 then\n    for i = 1, 5 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = (zMomentum - 0.1) * math.random()\n      topDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  elseif spinType == 1 then\n    for i = 1, 8 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = (zMomentum - 0.1) * math.random()\n      ballDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  elseif spinType == 2 then\n    for i = 1, 12 do\n      xMomentumVary = xMomentum + (math.random() - 0.5) * 0.02\n      yMomentumVary = yMomentum + (math.random() - 0.5) * 0.02\n      zMomentumVary = (zMomentum - 0.1) * math.random()\n      gyroscopeDebris:generateDebris(location, xMomentumVary, yMomentumVary, -zMomentumVary, currentZone)\n    end\n  end\nend"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "GERALD Transform": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/GERALD Transform"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/ModelCycler/Player Craft"
                  },
                  "variable": "playerCraftModels"
                },
                {
                  "to": {
                    "key": "Equilibria/ModelCycler/Alien Craft"
                  },
                  "variable": "alienCraftModels"
                },
                {
                  "to": {
                    "key": "Equilibria/Player/Player"
                  },
                  "variable": "player"
                },
                {
                  "to": {
                    "key": "Equilibria/Alien/Enemy Type 1"
                  },
                  "variable": "alienTypeA"
                },
                {
                  "to": {
                    "key": "Equilibria/Alien/Enemy Type 2"
                  },
                  "variable": "alienTypeB"
                }
              ],
              "code": "if hasFocus then\n  playerCraftModels:next()\n  alienCraftModels:next()\n  if spinType == 0 then\n    player:setSpinSpeed(0.0)\n    alienTypeA:setSpinSpeed(-360.0)\n    alienTypeB:setSpinSpeed(-180.0)\n    spinType = 1\n  elseif spinType == 1 then\n    player:setSpinSpeed(-360.0)\n    alienTypeA:setSpinSpeed(-180.0)\n    alienTypeB:setSpinSpeed(0.0)\n    spinType = 2\n  else\n    player:setSpinSpeed(-180.0)\n    alienTypeA:setSpinSpeed(0.0)\n    alienTypeB:setSpinSpeed(-360.0)\n    spinType = 0\n  end\nend"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Toggle Map": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Toggle Map"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Equilibria/WorldView/Game View/Camera"
                  },
                  "variable": "view"
                }
              ],
              "code": "if hasFocus then\n  if mapOverviewMode == 1 then\n    view:transitionToStart()\n    mapOverviewMode = 0\n  else\n    view:transitionToEnd()\n    mapOverviewMode = 1\n  end\nend"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Toggle Pause": {
            "value": {
              "key": "Replay/Replayer/Gameplay Recorder/Toggle Pause"
            },
            "onBecomingTrue": {
              "key": "Basics/Function/Equilibria Game Pause",
              "bindings": []
            },
            "onBecomingFalse": {
              "key": "None"
            }
          }
        },
