                      },
                      {
                        "to": {
                          "key": "UI/Menu/Launcher/LauncherList/List"
                        },
                        "variable": "launcherMenu"
                      },
                      {
                        "to": {
                          "key": ":Action",
                          "resource": {
                            "key": "Basics/Function/Options Enter Screen",
                            "bindings": [
                              {
                                "argument": "menuScreen",
                                "to": {
                                  "key": ":Screen",
                                  "resource": {
                                    "key": "UI/Menu/Launcher"
                                  }
                                }
                              },
                              {
                                "argument": "menu",
