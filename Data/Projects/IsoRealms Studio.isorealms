        "Prompt": {
          "Close": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
            },
            "message": "Close IsoRealms?  Changes won't be saved!",
            "cancelLabel": "Cancel",
            "confirmLabel": "Close",
            "onCancel": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/ResumeEditor",
                      "bindings": []
                    }
                  },
                  "variable": "cancelCloseIDEFunction"
                }
              ],
              "code": "gCloseIDERequested = nil\ncancelCloseIDEFunction:execute()"
            },
            "onConfirm": {
              "key": "Quit"
            }
          },
          "Load": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
            },
            "message": "Load App?  Changes to the current App won't be saved!",
            "cancelLabel": "Cancel",
            "confirmLabel": "Load App",
            "onCancel": {
              "key": "Basics/Function/Options Leave Screen",
              "bindings": []
            },
            "onConfirm": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Project/Project"
                  },
                  "variable": "project"
                },
                {
                  "to": {
                    "key": ":String",
                    "resource": {
                      "key": "Basics/String/MissionToLoad"
                    }
                  },
                  "variable": "file"
                },
                {
                  "to": {
                    "key": ":String",
                    "resource": {
                      "key": "Basics/String/MissionType"
                    }
                  },
                  "variable": "type"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/CloseAllMenus",
                      "bindings": []
                    }
                  },
                  "variable": "closeAllMenusFunction"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Menu"
                  },
                  "variable": "menuDisplay"
                },
                {
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Throbber/LoadingScreen"
                    }
                  },
                  "variable": "throbber"
                }
              ],
              "code": "project:prepare(file:getValue(), type:getValue() == \"user\", true)\ncloseAllMenusFunction:execute()\nmenuDisplay:setScreen(throbber)"
            }
          },
          "New": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
            },
            "message": "Create new App?  Changes won't be saved!",
            "cancelLabel": "Cancel",
            "confirmLabel": "New App",
            "onCancel": {
              "key": "Basics/Function/Options Leave Screen",
              "bindings": []
            },
            "onConfirm": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Project/Project"
                  },
                  "variable": "project"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/CloseAllMenus",
                      "bindings": []
                    }
                  },
                  "variable": "closeAllMenusFunction"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Menu"
                  },
                  "variable": "menuDisplay"
                },
                {
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Throbber/LoadingScreen"
                    }
                  },
                  "variable": "throbber"
                },
                {
                  "to": {
                    "key": "UI/Layout/Main/Editor"
                  },
                  "variable": "editorDisplay"
                },
                {
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Layout/EditorPlaceHolder"
                    }
                  },
                  "variable": "editorPlaceHolder"
                },
                {
                  "to": {
                    "key": "Basics/InputSwitch/DirectEditorInput"
                  },
                  "variable": "directEditorInput"
                }
              ],
              "code": "directEditorInput:setInputHandler(nil)\nproject:prepareNew()\ncloseAllMenusFunction:execute()\ngActiveEditor = nil\nmenuDisplay:setScreen(throbber)\neditorDisplay:setScreen(editorPlaceHolder)"
            }
          },
          "Overwrite": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
            },
            "message": "Overwrite existing project?",
            "cancelLabel": "Cancel",
            "confirmLabel": "Overwrite",
            "onCancel": {
              "key": "Basics/Function/Options Leave Screen",
              "bindings": []
            },
            "onConfirm": {
              "key": "Basics/Script",
              "bindings": [
