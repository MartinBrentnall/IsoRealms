              }
            ]
          },
          "PreviousTool": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "F1"
              },
              {
                "key": "GameControllerHat",
                "direction": "Left"
              }
            ]
          },
          "RotateView": {
            "mappings": [
              {
                "key": "MouseButton",
                "button": "Left"
              }
            ]
          },
          "ToolMode": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "Tab"
              },
              {
                "key": "GameControllerButton",
                "button": 3
              }
            ]
          },
          "UseTool": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "Space"
              },
              {
                "key": "GameControllerButton"
              }
            ]
          }
        },
        "Font": {
          "Code": {
            "filename": {
              "path": "Fonts/Inconsolata/static/Inconsolata-Regular.ttf"
            }
          }
        },
        "Function": {
          "CloseAllMenus": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "menuDisplay"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "interactiveInput"
              }
            ],
            "code": "gMenuScreenStack = {}\ngMenuInputStack = {}\nmenuDisplay:setScreen(nil)\ninteractiveInput:setInputHandler(nil)"
          },
          "LoadWorld": {
            "bindings": [
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/Options Enter Screen",
                    "bindings": [
                      {
                        "argument": "menuScreen",
                        "to": {
                          "key": ":Screen",
                          "resource": {
                            "key": "UI/Prompt/Load"
                          }
                        }
                      },
                      {
                        "argument": "menu",
                        "to": {
                          "key": "UI/Prompt/Load"
                        }
                      },
                      {
                        "argument": "menuInput",
                        "to": {
                          "key": ":InputHandler",
                          "resource": {
                            "key": "UI/Prompt/Load"
                          }
                        }
                      }
                    ]
                  }
                },
                "variable": "confirmLoadFunction"
              },
              {
                "to": {
                  "key": "Basics/String/MissionToLoad"
                },
                "variable": "missionToLoad"
              },
              {
                "to": {
                  "key": "Basics/String/MissionType"
                },
                "variable": "missionType"
              }
            ],
            "arguments": [
              {
                "name": "mission",
                "type": {
                  "key": "Any"
                },
                "luaName": "mission"
              },
              {
                "name": "user",
                "type": {
                  "key": "Any"
                },
                "luaName": "user"
              }
            ],
            "code": "missionFileName = mission:getValue()\nmissionToLoad:setValue(missionFileName);\nmissionUser = user:getValue()\nif missionUser then\n  missionType:setValue(\"user\")\nelse\n  missionType:setValue(\"program\")\nend\nconfirmLoadFunction:execute()"
          },
          "ResumeEditor": {
            "bindings": [
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/CloseAllMenus",
                    "bindings": []
                  }
                },
                "variable": "closeAllMenusFunction"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "interactiveInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputGroup/EditorInput"
                  }
                },
                "variable": "inputHandlerEditor"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/StartMenu",
                    "bindings": []
                  }
                },
                "variable": "startMenuFunction"
              },
              {
                "to": {
                  "key": "Application"
                },
                "variable": "application"
              }
            ],
            "code": "-- If there's an active editor, resume it, otherwise go to the main menu.\napplication:setName(\"IsoRealms Studio\")\nif gActiveEditor ~= nil then\n  gActiveProjectConfigurer = nil\n  closeAllMenusFunction:execute()\n  interactiveInput:setInputHandler(inputHandlerEditor)\n  gActiveEditor:notifyGainedFocus()\nelse\n  startMenuFunction:execute()\nend"
          },
          "StartEditor": {
            "bindings": [
              {
                "to": {
                  "key": "Basics/Project/Project"
                },
                "variable": "project"
              },
              {
                "to": {
                  "key": "UI/Layout/Main/Editor"
                },
                "variable": "interactiveDisplay"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "interactiveInput"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/DirectEditorInput"
                },
                "variable": "directEditorInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputGroup/EditorInput"
                  }
                },
                "variable": "editorInput"
              },
              {
                "to": {
                  "key": "UI/Layout/Main/Menu"
                },
                "variable": "menuDisplay"
              },
              {
                "to": {
                  "key": ":Font",
                  "resource": {
                    "key": "Basics/Font/Application Main Font"
                  }
                },
                "variable": "font"
              },
              {
                "to": {
                  "key": "Basics/ProjectConfigurer/ProjectConfigurer"
                },
                "variable": "projectConfigurer"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/Cancel"
                  }
                },
                "variable": "digitalInputCancel"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/ConfigureTool"
                  }
                },
                "variable": "digitalInputConfigureTool"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/NextTheme"
                  }
                },
                "variable": "digitalInputNextTheme"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/NextTool"
                  }
                },
                "variable": "digitalInputNextTool"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/PreviousTheme"
                  }
                },
                "variable": "digitalInputPreviousTheme"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/PreviousTool"
                  }
                },
                "variable": "digitalInputPreviousTool"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/ToolMode"
                  }
                },
                "variable": "digitalInputToolMode"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/UseTool"
                  }
                },
                "variable": "digitalInputUseTool"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorBackward"
                  }
                },
                "variable": "digitalInputMoveCursorBackward"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorDown"
                  }
                },
                "variable": "digitalInputMoveCursorDown"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorFaster"
                  }
                },
                "variable": "digitalInputMoveCursorFaster"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorForward"
                  }
                },
                "variable": "digitalInputMoveCursorForward"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorLeft"
                  }
                },
                "variable": "digitalInputMoveCursorLeft"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorRight"
                  }
                },
                "variable": "digitalInputMoveCursorRight"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorSlower"
                  }
                },
                "variable": "digitalInputMoveCursorSlower"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveCursorUp"
                  }
                },
                "variable": "digitalInputMoveCursorUp"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/MoveView"
                  }
                },
                "variable": "digitalInputMoveView"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/RotateView"
                  }
                },
                "variable": "digitalInputRotateView"
              },
              {
                "to": {
                  "key": ":Boolean",
                  "resource": {
                    "key": "Basics/DigitalControl/EditorMenu"
                  }
                },
                "variable": "digitalInputEditorMenu"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/MoveCursorX"
                  }
                },
                "variable": "analogueInputMoveCursorX"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/MoveCursorY"
                  }
                },
                "variable": "analogueInputMoveCursorY"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/MoveViewIn"
                  }
                },
                "variable": "analogueInputMoveViewIn"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/MoveViewOut"
                  }
                },
                "variable": "analogueInputMoveViewOut"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/RotateViewYaw"
                  }
                },
                "variable": "analogueInputRotateViewYaw"
              },
              {
                "to": {
                  "key": ":Float",
                  "resource": {
                    "key": "Basics/AnalogueControl/RotateViewPitch"
                  }
                },
                "variable": "analogueInputRotateViewPitch"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/StartMenu",
                    "bindings": []
                  }
                },
                "variable": "startMenuFunction"
              }
            ],
            "code": "if gEditorToStart ~= gEditorRunning then\n  gEditorRunning = gEditorToStart\n  if gActiveEditor ~= nil then\n    gActiveEditor:notifyHidden()\n  end\n  gActiveEditor = gEditorToStart:createEditableScreen(project:getProject(), projectConfigurer:getDialogManager())\n  gActiveEditor:setAppearance(font, 0.03)\n\n  gActiveEditor:setDigitalInput(\"Cancel\",             digitalInputCancel)\n  gActiveEditor:setDigitalInput(\"ConfigureTool\",      digitalInputConfigureTool)\n  gActiveEditor:setDigitalInput(\"MoveCursorBackward\", digitalInputMoveCursorBackward)\n  gActiveEditor:setDigitalInput(\"MoveCursorDown\",     digitalInputMoveCursorDown)\n  gActiveEditor:setDigitalInput(\"MoveCursorFaster\",   digitalInputMoveCursorFaster)\n  gActiveEditor:setDigitalInput(\"MoveCursorForward\",  digitalInputMoveCursorForward)\n  gActiveEditor:setDigitalInput(\"MoveCursorLeft\",     digitalInputMoveCursorLeft)\n  gActiveEditor:setDigitalInput(\"MoveCursorRight\",    digitalInputMoveCursorRight)\n  gActiveEditor:setDigitalInput(\"MoveCursorSlower\",   digitalInputMoveCursorSlower)\n  gActiveEditor:setDigitalInput(\"MoveCursorUp\",       digitalInputMoveCursorUp)\n  gActiveEditor:setDigitalInput(\"MoveView\",           digitalInputMoveView)\n  gActiveEditor:setDigitalInput(\"NextTheme\",          digitalInputNextTheme)\n  gActiveEditor:setDigitalInput(\"NextTool\",           digitalInputNextTool)\n  gActiveEditor:setDigitalInput(\"PreviousTheme\",      digitalInputPreviousTheme)\n  gActiveEditor:setDigitalInput(\"PreviousTool\",       digitalInputPreviousTool)\n  gActiveEditor:setDigitalInput(\"RotateView\",         digitalInputRotateView)\n  gActiveEditor:setDigitalInput(\"ToolMode\",           digitalInputToolMode)\n  gActiveEditor:setDigitalInput(\"UseTool\",            digitalInputUseTool)\n  gActiveEditor:setDigitalInput(\"Exit\",               digitalInputEditorMenu)\n\n  gActiveEditor:setAnalogueInput(\"MoveCursorX\",     analogueInputMoveCursorX)\n  gActiveEditor:setAnalogueInput(\"MoveCursorY\",     analogueInputMoveCursorY)\n  gActiveEditor:setAnalogueInput(\"MoveViewIn\",      analogueInputMoveViewIn)\n  gActiveEditor:setAnalogueInput(\"MoveViewOut\",     analogueInputMoveViewOut)\n  gActiveEditor:setAnalogueInput(\"RotateViewPitch\", analogueInputRotateViewPitch)\n  gActiveEditor:setAnalogueInput(\"RotateViewYaw\",   analogueInputRotateViewYaw)\n\n  gActiveEditor:setExitAction(startMenuFunction)\n  \n  gActiveEditor:notifyVisible()\n  interactiveDisplay:setScreen(gActiveEditor:screen())\n  interactiveInput:setInputHandler(editorInput)\n  directEditorInput:setInputHandler(gActiveEditor:inputHandler())\n  menuDisplay:setScreen(nil)\nelse\n  gActiveEditor:notifyGainedFocus()\nend"
          },
          "StartMenu": {
            "bindings": [
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/CloseAllMenus",
                    "bindings": []
                  }
                },
                "variable": "closeAllMenusFunction"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "interactiveInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputSwitch/Options Screen"
                  }
                },
                "variable": "inputHandlerMenu"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/Options Enter Screen",
                    "bindings": [
                      {
                        "argument": "menuScreen",
                        "to": {
                          "key": ":Screen",
                          "resource": {
                            "key": "UI/Menu/Main"
                          }
                        }
                      },
                      {
                        "argument": "menu",
                        "to": {
                          "key": "UI/Menu/Main"
                        }
                      },
                      {
                        "argument": "menuInput",
                        "to": {
                          "key": ":InputHandler",
                          "resource": {
                            "key": "UI/Menu/Main"
                          }
                        }
                      }
                    ]
                  }
                },
                "variable": "showMenuFunction"
              }
            ],
            "code": "closeAllMenusFunction:execute()\ninteractiveInput:setInputHandler(inputHandlerMenu)\nif gActiveEditor ~= nil then\n  gActiveEditor:notifyLostFocus()\nend\nshowMenuFunction:execute()"
          },
          "StopProjectExecution": {
            "bindings": [
              {
                "to": {
                  "key": "UI/Layout/Runtime/Screen"
                },
                "variable": "interactiveDisplay"
              },
              {
                "to": {
                  "key": ":Screen",
                  "resource": {
                    "key": "UI/Layout/Main"
                  }
                },
                "variable": "editorScreen"
              },
              {
                "to": {
                  "key": "Basics/InputSwitch/Main"
                },
                "variable": "interactiveInput"
              },
              {
                "to": {
                  "key": ":InputHandler",
                  "resource": {
                    "key": "Basics/InputGroup/EditorInput"
                  }
                },
                "variable": "editorInput"
              },
              {
                "to": {
                  "key": "Basics/Project/Project"
                },
                "variable": "project"
              },
              {
                "to": {
                  "key": ":Action",
                  "resource": {
                    "key": "Basics/Function/ResumeEditor",
                    "bindings": []
                  }
                },
                "variable": "resumeEditorFunction"
              }
            ],
            "code": "if gProjectExecuting ~= nil then\n  if gActiveEditor ~= nil then\n    gActiveEditor:notifyVisible()\n  end\n  interactiveDisplay:setScreen(editorScreen)\n  interactiveInput:setInputHandler(editorInput)\n  project:reset()\n  project:setEditing(true)\n  project:setRunning(false)\n  gProjectExecuting = nil\n  resumeEditorFunction:execute()\nend"
          }
        },
