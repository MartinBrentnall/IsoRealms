                    "resource": {
                      "key": "Basics/Function/ResumeEditor",
                      "bindings": []
                    }
                  },
                  "variable": "resumeEditorFunction"
                }
              ],
              "code": "project:saveAs(\"Projects/\" .. filename:getValue())\nresumeEditorFunction:execute()"
            }
          },
          "Quit": {
            "font": {
              "key": "Basics/Font/Application Main Font"
            },
            "selectionColour": {
              "key": "Basics/Sequence/Colour Cycle (Menu Selection Highlight)/Instance/Colour"
