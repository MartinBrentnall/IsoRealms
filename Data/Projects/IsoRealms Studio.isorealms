{
  "project": {
    "include": [
      {
        "filename": {
          "path": "Projects/Spindizzy/Options.isorealms"
        }
      }
    ],
    "onStart": {
      "key": "Basics/Script",
      "bindings": [
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/CloseAllMenus",
              "bindings": []
            }
          },
          "variable": "closeAllMenusFunction"
        },
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/Options Enter Screen",
              "bindings": [
                {
                  "argument": "menuScreen",
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Menu/Main"
                    }
                  }
                },
                {
                  "argument": "menu",
                  "to": {
                    "key": "UI/Menu/Main"
                  }
                },
                {
                  "argument": "menuInput",
                  "to": {
                    "key": ":InputHandler",
                    "resource": {
                      "key": "UI/Menu/Main"
                    }
                  }
                }
              ]
            }
          },
          "variable": "showMenuFunction"
        },
        {
          "to": {
            "key": "Basics/InputSwitch/Main"
          },
          "variable": "interactiveInput"
        },
        {
          "to": {
            "key": ":InputHandler",
            "resource": {
              "key": "Basics/InputSwitch/Options Screen"
            }
          },
          "variable": "inputHandlerMenu"
        },
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/Options Reload Configuration",
              "bindings": []
            }
          },
          "variable": "optionsLoaderFunction"
        },
        {
          "to": {
            "key": "Application"
          },
          "variable": "application"
        }
      ],
      "code": "optionsLoaderFunction:execute()\napplication:setName(\"IsoRealms Studio\")\ncloseAllMenusFunction:execute()\nshowMenuFunction:execute()\ninteractiveInput:setInputHandler(inputHandlerMenu)"
    },
    "onCloseRequest": {
      "key": "Basics/Script",
      "bindings": [
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/StopProjectExecution",
              "bindings": []
            }
          },
          "variable": "stopProjectExecutionFunction"
        },
        {
          "to": {
            "key": "Basics/ProjectConfigurer/ProjectConfigurer"
          },
          "variable": "projectConfigurer"
        },
        {
          "to": {
            "key": "Basics/InputSwitch/Main"
          },
          "variable": "interactiveInput"
        },
        {
          "to": {
            "key": ":InputHandler",
            "resource": {
              "key": "Basics/InputSwitch/Options Screen"
            }
          },
          "variable": "inputHandlerMenu"
        },
        {
          "to": {
            "key": ":Action",
            "resource": {
              "key": "Basics/Function/Options Enter Screen",
              "bindings": [
                {
                  "argument": "menuScreen",
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Prompt/Close"
                    }
                  }
                },
                {
                  "argument": "menu",
                  "to": {
                    "key": "UI/Prompt/Close"
                  }
                },
                {
                  "argument": "menuInput",
                  "to": {
                    "key": ":InputHandler",
                    "resource": {
                      "key": "UI/Prompt/Close"
                    }
                  }
                }
              ]
            }
          },
          "variable": "confirmQuitFunction"
        }
      ],
      "code": "if gCloseIDERequested == nil then\n  if gActiveProjectConfigurer then\n    projectConfigurer:hide()\n  end\n  stopProjectExecutionFunction:execute()\n  interactiveInput:setInputHandler(inputHandlerMenu)\n  confirmQuitFunction:execute()\n  gCloseIDERequested = true\nend"
    },
    "input": {
      "key": "Basics/InputSwitch/Main"
    },
    "screen": {
      "key": "UI/Layout/Runtime"
    },
    "editor": {
      "key": "None"
    },
    "modules": {
      "Basics": {
        "AnalogueControl": {
          "MoveCursorX": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "deadZone": 0.15259000658988954
              }
            ]
          },
          "MoveCursorY": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "axis": 1,
                "deadZone": 0.15259000658988954
              }
            ]
          },
          "MoveViewIn": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "axis": 3,
                "deadZone": 0.15259000658988954
              }
            ]
          },
          "MoveViewOut": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "axis": 2,
                "deadZone": 0.15259000658988954
              }
            ]
          },
          "RotateViewPitch": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "axis": 5,
                "deadZone": 0.15259000658988954
              }
            ]
          },
          "RotateViewYaw": {
            "mappings": [
              {
                "key": "GameControllerAxis",
                "axis": 4,
                "deadZone": 0.15259000658988954
              }
            ]
          }
        },
        "BooleanTrigger": {
          "EndTest": {
            "value": {
              "key": "Basics/DigitalControl/EndTest"
            },
            "onBecomingTrue": {
              "key": "Basics/Script",
              "bindings": [
                {
                  "to": {
                    "key": "Basics/Project/Project"
                  },
                  "variable": "project"
                },
                {
                  "to": {
                    "key": "UI/Layout/Runtime/Screen"
                  },
                  "variable": "interactiveDisplay"
                },
                {
                  "to": {
                    "key": "Basics/InputSwitch/Main"
                  },
                  "variable": "interactiveInput"
                },
                {
                  "to": {
                    "key": ":InputHandler",
                    "resource": {
                      "key": "Basics/InputGroup/EditorInput"
                    }
                  },
                  "variable": "editorInput"
                },
                {
                  "to": {
                    "key": ":Screen",
                    "resource": {
                      "key": "UI/Layout/Main"
                    }
                  },
                  "variable": "editorScreen"
                },
                {
                  "to": {
                    "key": ":Action",
                    "resource": {
                      "key": "Basics/Function/ResumeEditor",
                      "bindings": []
                    }
                  },
                  "variable": "resumeEditorFunction"
                }
              ],
              "code": "gActiveEditor:notifyVisible()\ninteractiveDisplay:setScreen(editorScreen)\ninteractiveInput:setInputHandler(editorInput)\nproject:reset()\nproject:setEditing(true)\nproject:setRunning(false)\ngProjectExecuting = nil\nresumeEditorFunction:execute()"
            },
            "onBecomingFalse": {
              "key": "None"
            }
          },
          "Pause": {
            "value": {
              "key": "Basics/DigitalControl/Toggle Pause"
            },
            "onBecomingTrue": {
              "key": "Basics/Function/StartMenu",
              "bindings": []
            },
            "onBecomingFalse": {
              "key": "None"
            }
          }
        },
        "DigitalControl": {
          "Cancel": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "Escape"
              },
              {
                "key": "GameControllerButton",
                "button": 1
              }
            ]
          },
          "ConfigureTool": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "F3"
              },
              {
