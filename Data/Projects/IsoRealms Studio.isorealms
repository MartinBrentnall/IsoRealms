                "which": "Escape"
              },
              {
                "key": "GameControllerButton",
                "button": 9
              }
            ]
          },
          "EndTest": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "C"
              },
              {
                "key": "GameControllerButton",
                "button": 10
              }
            ]
          },
          "MoveCursorBackward": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "ArrowDown"
              }
            ]
          },
          "MoveCursorDown": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "PageDown"
              },
              {
                "key": "GameControllerButton",
                "button": 4
              }
            ]
          },
          "MoveCursorFaster": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "LeftControl"
              }
            ]
          },
          "MoveCursorForward": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "ArrowUp"
              }
            ]
          },
          "MoveCursorLeft": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "ArrowLeft"
              }
            ]
          },
          "MoveCursorRight": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "ArrowRight"
              }
            ]
          },
          "MoveCursorSlower": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "LeftShift"
              }
            ]
          },
          "MoveCursorUp": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "PageUp"
              },
              {
                "key": "GameControllerButton",
                "button": 5
              }
            ]
          },
          "MoveView": {
            "mappings": [
              {
                "key": "MouseButton",
                "button": "Right"
              }
            ]
          },
          "NextTheme": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "End"
              },
              {
                "key": "GameControllerHat",
                "direction": "Up"
              }
            ]
          },
          "NextTool": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "F2"
              },
              {
                "key": "GameControllerHat",
                "direction": "Right"
              }
            ]
          },
          "PreviousTheme": {
            "mappings": [
              {
                "key": "KeyboardKey",
                "which": "Home"
              },
              {
                "key": "GameControllerHat",
